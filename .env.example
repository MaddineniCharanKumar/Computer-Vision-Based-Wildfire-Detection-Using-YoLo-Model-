# Environment configuration for EcoSpread-YOLO
# Copy this file to .env and fill in real values for your deployment.

# Core runtime
FIREGUARD_DEMO_MODE=false
FIREGUARD_DATABASE_URL=sqlite:///./fireguard.db
FIREGUARD_MODEL_WEIGHTS=
FIREGUARD_DEVICE=cpu
FIREGUARD_DATASET_PATH=
FIREGUARD_CORS_ORIGINS=http://localhost:5173
FIREGUARD_CONFIDENCE_THRESHOLD=0.35
FIREGUARD_TEMPORAL_WINDOW=12
FIREGUARD_MINIMUM_PERSISTENCE=3
FIREGUARD_CAMERA_FRAME_SKIP=0
FIREGUARD_UPLOAD_MAX_MB=100

# Environmental providers
FIREGUARD_ENVIRONMENT_PROVIDER=unavailable
FIREGUARD_WEATHER_API_URL=
FIREGUARD_WEATHER_API_KEY=
FIREGUARD_ENVIRONMENT_MAX_AGE_SECONDS=300
FIREGUARD_SATELLITE_PROVIDER=none
FIREGUARD_TERRAIN_PROVIDER=none
FIREGUARD_VEGETATION_PROVIDER=none

# Alerting and forecasting
FIREGUARD_ALERT_COOLDOWN_SECONDS=60
FIREGUARD_FORECAST_HORIZONS=30,60
FIREGUARD_ALERT_THRESHOLD=0.6

# Camera and stream configuration
FIREGUARD_CAMERA_URL=
FIREGUARD_CAMERA_ID=default-camera

# Optional external services
FIREGUARD_MQTT_BROKER=
FIREGUARD_MQTT_TOPIC=
FIREGUARD_WEBSOCKET_URL=

# Optional credentials; keep secrets out of the repo.
FIREGUARD_API_TOKEN=

# Local file outputs
FIREGUARD_REPORTS_DIR=reports
FIREGUARD_LOG_DIR=logs
